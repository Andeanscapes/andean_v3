# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.development
.env.production
.dev.vars
.dev.vars.*
.env.wrangler
.env.wrangler.*

# vercel
.vercel

# OpenNext build output
.open-next

# Wrangler / Miniflare local state (binary caches, never source)
.wrangler/

# Local copies of the remote feed. Real business data — never committed.
# Populated by `npm run fixtures:fetch` (runs automatically before `npm test`).
#
# `/fixtures/*` rather than `/fixtures/`: a negation cannot re-include anything
# inside a directory that is itself excluded, and README.md must stay tracked so
# the directory is documented and present on a fresh clone.
/fixtures/*
!/fixtures/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

.env
.env.local
.env*.local
# Storybook build output. Publish from CI; never commit the built bundle.
storybook-static/
