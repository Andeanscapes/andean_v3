{
  "name": "arid-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.23.4",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "fixtures:fetch": "vite-node -c vitest.config.mts scripts/fetch-fixtures.ts",
    "pretest": "npm run fixtures:fetch",
    "test": "vitest run",
    "pretest:watch": "npm run fixtures:fetch",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:worker": "dotenv -e .env.wrangler -- opennextjs-cloudflare build && npm run typecheck:worker",
    "preview": "npm run build:worker && dotenv -e .env.wrangler -- opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && dotenv -e .env.wrangler -- opennextjs-cloudflare deploy",
    "deploy:dev": "npm run build:worker && dotenv -e .env.wrangler -- opennextjs-cloudflare deploy --env dev",
    "upload": "npm run build:worker && dotenv -e .env.wrangler -- opennextjs-cloudflare upload",
    "cf-typegen": "dotenv -e .env.wrangler -- wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "verify:feed": "vite-node -c vitest.config.mts scripts/verify-feed.ts",
    "feed:stage-hero-variants": "vite-node -c vitest.config.mts scripts/stage-hero-variants.ts",
    "feed:publish": "vite-node -c vitest.config.mts scripts/publish-feed.ts",
    "feed:sync": "dotenv -e .env.wrangler -- vite-node -c vitest.config.mts scripts/sync-fixtures.ts",
    "media:pull": "vite-node -c vitest.config.mts scripts/pull-cdn-media.ts",
    "media:optimize": "vite-node -c vitest.config.mts scripts/optimize-media.ts",
    "media:push": "dotenv -e .env.wrangler -- vite-node -c vitest.config.mts scripts/push-cdn-media.ts",
    "media:sync": "dotenv -e .env.wrangler -- vite-node -c vitest.config.mts scripts/sync-media.ts",
    "media:sync:new": "dotenv -e .env.wrangler -- vite-node -c vitest.config.mts scripts/push-cdn-media.ts --upscale --allow-orphan",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "daisyui": "5.6.16",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "next-intl": "^4.13.2",
    "rc-slider": "^10.5.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.3.1",
    "react-fast-marquee": "^1.6.2",
    "react-leaflet": "^5.0.0",
    "react-parallax": "^3.5.1",
    "react-photo-album": "^2.3.0",
    "react-select": "^5.8.0",
    "swiper": "^14.0.5",
    "use-context-selector": "^1.4.1",
    "yet-another-react-lightbox": "^3.15.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "1.20.13",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-links": "10.6.4",
    "@storybook/react": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv-cli": "^8.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "patch-package": "^8.0.1",
    "postcss": "8.5.26",
    "storybook": "10.6.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vite": "8.3.5",
    "vite-node": "6.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  },
  "browserslist": "> 1%"
}
