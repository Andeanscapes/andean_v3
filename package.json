{
  "name": "arid-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.23.1",
    "npm": "10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "dotenv -e .env.wrangler -- opennextjs-cloudflare build && dotenv -e .env.wrangler -- opennextjs-cloudflare preview",
    "deploy": "dotenv -e .env.wrangler -- opennextjs-cloudflare build && dotenv -e .env.wrangler -- opennextjs-cloudflare deploy",
    "deploy:dev": "dotenv -e .env.wrangler -- opennextjs-cloudflare build && dotenv -e .env.wrangler -- opennextjs-cloudflare deploy --env dev",
    "upload": "dotenv -e .env.wrangler -- opennextjs-cloudflare build && dotenv -e .env.wrangler -- opennextjs-cloudflare upload",
    "cf-typegen": "dotenv -e .env.wrangler -- wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "daisyui": "^5.6.16",
    "lucide-react": "^0.577.0",
    "next": "16.2.11",
    "next-intl": "^4.13.2",
    "rc-slider": "^10.5.0",
    "react": "^19.2.7",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.7",
    "react-fast-marquee": "^1.6.2",
    "react-leaflet": "^5.0.0",
    "react-parallax": "^3.5.1",
    "react-photo-album": "^2.3.0",
    "react-select": "^5.8.0",
    "swiper": "^14.0.5",
    "use-context-selector": "^1.4.1",
    "yet-another-react-lightbox": "^3.15.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@opennextjs/cloudflare": "1.20.2",
    "@storybook/addon-docs": "8.6.18",
    "@storybook/addon-links": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@tailwindcss/cli": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "6.1.0",
    "dotenv-cli": "^8.0.0",
    "esbuild": "0.25.4",
    "eslint": "^9.39.5",
    "jsdom": "30.0.1",
    "patch-package": "^8.0.1",
    "postcss": "8.5.26",
    "storybook": "8.6.18",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "browserslist": "> 1%"
}
