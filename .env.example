# Template for local development: `cp .env.example .env.local`, then fill in.
#
# Values are intentionally left blank. This file documents which variables the
# build needs, not what they are set to — real values live in the repository
# Variables for CI and in `.env.local` on your machine. Current public values
# are documented in README.MD under "Data Source".
#
# Never add a secret here. Everything in this file reaches a public place:
# NEXT_PUBLIC_* is compiled into the browser bundle, and this file is tracked.
# Cloudflare credentials belong in `.env.wrangler` (gitignored); runtime Worker
# secrets belong in `wrangler secret put`.

# Public business phone, digits only, E.164 without the leading "+".
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# Optional override for the origin serving site images and videos. Leave blank:
# the code already defaults to the public CDN, so CI does not set this and there
# is no repository Variable for it. Only set it to point at a different origin.
NEXT_PUBLIC_CDN_BASE_URL=

# Google Search Console HTML-tag verification token (the `content` value only).
# Public by design: it is emitted as a <meta> tag. Optional; omitted when blank.
# Read at build time (most pages are prerendered), so CI supplies it to the
# production build only — the dev Worker must not claim the property.
GOOGLE_SITE_VERIFICATION=

# Feed origin. Read at build time for prerendering, and per request on the
# deployed Worker, which gets its own copy from `wrangler.toml [vars]`.
# Required: services have no local fallback, so every data page throws without it.
REMOTE_DATA_BASE_URL=

# ── Payments and operator alerts (server-only, never NEXT_PUBLIC_) ──────────
# These are secrets, so they are documented here but not declared: copy the
# keys you need into `.env.local` (gitignored). Deployed Workers get them from
# `wrangler secret put <KEY> [--env dev]`; non-secret settings come from
# `wrangler.toml [vars]`.
#
# Mercado Pago Checkout Pro. Locally use test credentials (a test-user seller
# account or a legacy `TEST-` token); the token's account must match the mode.
#   MERCADOPAGO_ACCESS_TOKEN=   secret
#   MERCADOPAGO_MODE=           `sandbox` (default) | `production` — wrangler.toml
#
# Telegram alert for approved deposits: the WhatsApp sales bot's bot and bridge
# chat (its dev bot locally/dev, prod bot in prod). Leave unset to skip.
#   TELEGRAM_BOT_TOKEN=         secret
#   TELEGRAM_CHAT_ID=           secret
#
# Email alert via Resend. The sender must be on a domain verified in Resend.
# Configure and verify before going live: a channel that refuses an alert (bad
# token, unverified sender) is not retried for that payment.
#   RESEND_API_KEY=             secret
#   ALERT_EMAIL_TO=             secret (personal data)
#   ALERT_EMAIL_FROM=           wrangler.toml, e.g. Andean Scapes <reservas@notify.andeanscapes.com>
