# Template for local development: `cp .env.example .env.local`, then fill in.
#
# Values are intentionally left blank. This file documents which variables the
# build needs, not what they are set to — real values live in the repository
# Variables for CI and in `.env.local` on your machine. Current public values
# are documented in README.MD under "Data Source".
#
# Never add a secret here. Everything in this file reaches a public place:
# NEXT_PUBLIC_* is compiled into the browser bundle, and this file is tracked.
# Cloudflare credentials belong in `.env.wrangler` (gitignored); runtime Worker
# secrets belong in `wrangler secret put`.

# Public business phone, digits only, E.164 without the leading "+".
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=

# Optional override for the origin serving site images and videos. Leave blank:
# the code already defaults to the public CDN, so CI does not set this and there
# is no repository Variable for it. Only set it to point at a different origin.
NEXT_PUBLIC_CDN_BASE_URL=

# Feed origin. Read at build time for prerendering, and per request on the
# deployed Worker, which gets its own copy from `wrangler.toml [vars]`.
# Required: services have no local fallback, so every data page throws without it.
REMOTE_DATA_BASE_URL=
